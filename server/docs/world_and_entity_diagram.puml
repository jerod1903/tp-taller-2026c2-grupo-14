---
config:
  layout: elk
  theme: dark
---
classDiagram
direction TB

namespace GameMap {
    class World {
        -Farm farm
        -Town town
        -Dungeon dungeon
        +locationOf(Player) Location
        +travel(Player, Portal) void
    }

    class Location {
        <<abstract>>
        #string name
        #Grid grid
        #vector~Portal~ portals
        +isWalkable(Position) bool
        +portalAt(Position) Portal
        +update(dt) void*
    }

    class Farm {
        -Position cabinPos
        -Cabin cabin
        +getCabin() Cabin
    }

    class Cabin {
        -Position doorPos
    }

    class Town {
        -Position communityCenterPos
        -Position dungeonEntrancePos
    }

    class Dungeon {
        -vector~DungeonLevel~ levels
        +entryLevel() DungeonLevel
        +level(int) DungeonLevel
    }

    class DungeonLevel {
        -int depth
    }

    class Portal {
        +Position origin
        +Location target
        +Position arrival
    }

    class Grid {
        -int width
        -int height
        +at(Position) Tile
        +inBounds(Position) bool
    }

    class Tile {
        -TileType type
        -bool walkable
    }

    class TileType {
        <<enumeration>>
        common/map: stardew::maps::TileType
    }

    class Position {
        +int x
        +int y
    }
}

namespace Characters {
    class Entity {
        <<abstract>>
        #int id
        #Position pos
        #Location location
        +update(dt) void*
    }

    class Creature {
        <<abstract>>
        #int health
        #float baseSpeed
        +takeDamage(int) void
        +isAlive() bool
        +speed() float
    }

    class Player {
        -string name
        -int gold
        -int energy
        +useTool(Position) void
    }

    class Enemy {
        <<abstract>>
        +onDeath() void
    }

    class Skeleton
    class Orc
    class Vampire
    class Skull

    class Merchant {
        -string name
        +handle(Player, Command) Reply
    }
}

%% ===== GameMap =====
World *-- Farm
World *-- Town
World *-- Dungeon
Location <|-- Farm
Location <|-- Cabin
Farm *-- Cabin
Location <|-- Town
Location <|-- DungeonLevel
Dungeon *-- "10" DungeonLevel
Location *-- Grid
Location *-- "0..*" Portal
Portal --> Location : target
Grid *-- "0..*" Tile
Tile --> TileType
Tile ..> Position

%% ===== Characters =====
Entity <|-- Creature
Entity <|-- Merchant
Creature <|-- Player
Creature <|-- Enemy
Enemy <|-- Skeleton
Enemy <|-- Orc
Enemy <|-- Vampire
Enemy <|-- Skull

%% ===== Entre namespaces =====
Location o-- "0..*" Entity : contiene
Entity --> Location : location
World ..> Player : locationOf
Town o-- "4" Merchant