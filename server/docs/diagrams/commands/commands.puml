@startuml commands
!pragma layout smetana
hide empty members
skinparam classAttributeIconSize 0

interface GameContext {
  + sessions(): PlayerSessions&
  + movement(): PlayerMovement&
  + characters(): PlayerCharacters&
  + farming(): PlayerFarming&
}
interface PlayerSessions {
  + add_player(player_id, GameMember, Outbox)
  + remove_player(player_id)
  + send_to(player_id, GameMessage)
  + broadcast(GameMessage)
  + find_player_by_name(name): player_id
}
interface PlayerCharacters {
  + find_player(player_id): Player*
}
interface PlayerFarming {
  + dig(Player): bool
  + plant(Player, CropType): bool
  + water(Player): bool
  + harvest(Player): Outcome&
  + milk(Player): Outcome&
}
interface PlayerMovement {
  + move_player(player_id, Direction)
  + enter_portal(player_id)
}
class Game
class Sessions
class Movement
class World
abstract class GameCommand {
  # player_id: uint32_t
  + {abstract} execute(GameContext&)
}
class MoveCommand {
  - request: MoveRequest
}
class JoinCommand {
  - member: GameMember
  - outbox: shared_ptr<Outbox>
}
class LeaveCommand
class EnterPortalCommand
class ChatCommand
class InteractCommand
class UseToolCommand
class SelectSlotCommand
class TypingCommand
class CommandFactory {
  - builders: map<GameOp, Builder>
  + create(GameOp, player_id): GameCommand
}
class Receiver
class LobbySession

GameContext <|.. Game
PlayerSessions <|.. Sessions
PlayerMovement <|.. Movement
PlayerCharacters <|.. World
PlayerFarming <|.. World
GameContext ..> PlayerCharacters
GameContext ..> PlayerFarming
Game ..> World : characters() y farming()
ChatCommand ..> PlayerSessions : usa
ChatCommand ..> PlayerCharacters : usa
InteractCommand ..> PlayerSessions : usa
InteractCommand ..> PlayerCharacters : usa
InteractCommand ..> PlayerFarming : por las Interaction
UseToolCommand ..> PlayerCharacters : usa
UseToolCommand ..> PlayerFarming : por las Tool
SelectSlotCommand ..> PlayerSessions : usa
SelectSlotCommand ..> PlayerCharacters : usa
TypingCommand ..> PlayerCharacters : usa
GameCommand <|-- ChatCommand
GameCommand <|-- InteractCommand
GameCommand <|-- UseToolCommand
GameCommand <|-- SelectSlotCommand
GameCommand <|-- TypingCommand
GameContext ..> PlayerSessions
GameContext ..> PlayerMovement
Game *-- Sessions
Game ..> Movement : movement() devuelve el del World
JoinCommand ..> PlayerSessions : usa
LeaveCommand ..> PlayerSessions : usa
MoveCommand ..> PlayerMovement : usa
EnterPortalCommand ..> PlayerMovement : usa
GameCommand <|-- MoveCommand
GameCommand <|-- JoinCommand
GameCommand <|-- LeaveCommand
GameCommand <|-- EnterPortalCommand
GameCommand ..> GameContext : execute
CommandFactory ..> MoveCommand : crea
CommandFactory ..> EnterPortalCommand : crea
Receiver *-- CommandFactory
Receiver ..> LeaveCommand : crea al cortarse
LobbySession ..> JoinCommand : crea al entrar
@enduml
