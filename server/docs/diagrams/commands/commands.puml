@startuml commands
!pragma layout smetana
hide empty members
skinparam classAttributeIconSize 0

interface GameContext {
  + sessions(): PlayerSessions&
  + movement(): PlayerMovement&
}
interface PlayerSessions {
  + add_player(player_id, GameMember, Outbox)
  + remove_player(player_id)
}
interface PlayerMovement {
  + move_player(player_id, Direction)
  + enter_portal(player_id)
}
class Game
class Sessions
class Movement
abstract class GameCommand {
  # player_id: uint32_t
  + {abstract} execute(GameContext&)
}
class MoveCommand {
  - request: MoveRequest
}
class JoinCommand {
  - member: GameMember
  - outbox: shared_ptr<Outbox>
}
class LeaveCommand
class EnterPortalCommand
class CommandFactory {
  - builders: map<GameOp, Builder>
  + create(GameOp, player_id): GameCommand
}
class Receiver
class LobbySession

GameContext <|.. Game
PlayerSessions <|.. Sessions
PlayerMovement <|.. Movement
GameContext ..> PlayerSessions
GameContext ..> PlayerMovement
Game *-- Sessions
Game ..> Movement : movement() devuelve el del World
JoinCommand ..> PlayerSessions : usa
LeaveCommand ..> PlayerSessions : usa
MoveCommand ..> PlayerMovement : usa
EnterPortalCommand ..> PlayerMovement : usa
GameCommand <|-- MoveCommand
GameCommand <|-- JoinCommand
GameCommand <|-- LeaveCommand
GameCommand <|-- EnterPortalCommand
GameCommand ..> GameContext : execute
CommandFactory ..> MoveCommand : crea
CommandFactory ..> EnterPortalCommand : crea
Receiver *-- CommandFactory
Receiver ..> LeaveCommand : crea al cortarse
LobbySession ..> JoinCommand : crea al entrar
@enduml
