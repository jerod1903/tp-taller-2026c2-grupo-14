@startuml world
!pragma layout smetana
hide empty members
skinparam classAttributeIconSize 0

package Mundo {
  interface PlayerMovement {
    + move_player(id, Direction)
    + enter_portal(id)
  }
  interface PlayerCharacters {
    + find_player(id): Player*
  }
  interface PlayerFarming {
    + dig / plant / water(Player, Position)
    + harvest / milk(Player): Outcome&
  }
  class GameClock {
    - day: uint16_t
    - elapsed: float
    + get_minute_of_day(): float
    + update(dt): bool
    + end_day()
  }
  class World {
    - farm: Farm
    - town: Town
    - dungeon: Dungeon
    - movement: Movement
    - players: map<id, Player>
    - clock: GameClock
    + spawn_player(id, name)
    + remove_player(id)
    + get_movement(): Movement&
    + update(dt)
    - start_new_day()
    - everyone_unconscious(): bool
  }
  class Movement {
    - farm: Farm&
    - players: map<id, Player>&
    + spawn_point(player_id): SpawnPoint
    + move_player(id, Direction)
    + enter_portal(id)
    + travel_through_portals()
    + free_trapped()
  }
  class SpawnPoint <<struct>> {
    + location: Location&
    + point: Point
  }
  class Point <<struct>> {
    + x, y: float
  }
  abstract class Location {
    # name: string
    # grid: Grid
    # portals: vector<Portal>
    # entities: vector<Entity*>
    # ground_items: map<Position, ItemType>
    + is_walkable(Position): bool
    + portal_at(Position): Portal
    + drop(Position, ItemType): bool
    + pick_up(Player): Outcome&
    + take_changes(): bool
    + {abstract} update(dt)
  }
  class Farm {
    - cabin_pos: Position
    - animals: vector<Animal>
    - plots: map<Position, Plot>
    + bed_spawn(player_id): SpawnPoint
    + dig(Position): bool
    + plant(Position, CropType): bool
    + water(Position): bool
    + harvest(Position, Player): Outcome&
    + update_time(minute_of_day)
    + start_new_day()
  }
  class Plot <<struct>> {
    + soil: SoilType
    + crop: Crop
  }
  class Crop {
    - type: CropType
    - days_grown: int
    - waterings, skipped: int
    + water(minute)
    + grow()
    + is_ready(): bool
    + quality(minute, luck): ItemQuality
    + harvested()
  }
  class Cabin {
    - door_pos: Position
    - bed_slots: vector<Position>
    - beds: map<player_id, Position>
    + assign_bed(player_id): Position
    + bed_spawn(player_id): SpawnPoint
    + is_in_bed(Player): bool
    + is_walkable(Position): bool
  }
  class Town
  class Dungeon {
    + entry_level(): DungeonLevel
    + level(depth): DungeonLevel
  }
  class DungeonLevel {
    - depth: int
    - enemies: vector<Enemy>
  }
  class Grid {
    + at(Position): Tile
    + in_bounds(Position): bool
  }
  class Tile {
    - type: TileType
    - walkable: bool
  }
  class Portal <<struct>> {
    + origin: Position
    + target: Location*
    + arrival: Point
    + trigger: PortalTrigger
  }
  enum PortalTrigger {
    Step
    Action
  }
}

package Personajes {
  abstract class Entity {
    # id: uint32_t
    # pos: Position
    # location: Location*
    + relocate(Location, Position)
    + {abstract} update(dt)
  }
  abstract class Creature {
    # health: int
    # direction: Direction
    # x, y: float
    + set_direction(Direction)
    + place_at(Point)
    + has_stepped(): bool
    + is_trapped(): bool
    # advance(dt): bool
  }
  class Player {
    - name: string
    - gold: int
    - energy, max_energy: int
    - max_health: int
    - inventory: Inventory
    + spend_energy(int)
    + is_unconscious(): bool
    + wake_up(SpawnPoint, slept_in_bed)
    + speed(): float
    + receive(ItemType, n, ItemQuality): uint8_t
  }
  abstract class Animal {
    - kind: AnimalKind
    + {abstract} start_new_day()
    + take_drop(): optional<ItemType>
  }
  class Cow
  class Chicken {
    - lay_in: optional<float>
  }
  abstract class Enemy {
    + on_death()
  }
  class Skeleton
}

PlayerMovement <|.. Movement
PlayerCharacters <|.. World
PlayerFarming <|.. World
World *-- GameClock
World *-- Farm
World *-- Town
World *-- Dungeon
World *-- Movement
World *-- "0..*" Player
Movement --> Farm : pide la cama
Movement ..> SpawnPoint
SpawnPoint *-- Point
Portal *-- PortalTrigger
Location <|-- Farm
Location <|-- Cabin
Location <|-- Town
Location <|-- DungeonLevel
Farm *-- Cabin
Farm *-- "0..*" Animal
Farm *-- "0..*" Plot
Plot *-- Crop
Dungeon *-- "10" DungeonLevel
DungeonLevel *-- "0..*" Enemy
Location *-- Grid
Location *-- "0..*" Portal
Grid *-- "0..*" Tile
Portal --> Location : target

Entity <|-- Creature
Creature <|-- Player
Creature <|-- Animal
Animal <|-- Cow
Animal <|-- Chicken
Creature <|-- Enemy
Enemy <|-- Skeleton
Location o-- "0..*" Entity : las que están adentro
Entity --> Location : dónde está
@enduml
